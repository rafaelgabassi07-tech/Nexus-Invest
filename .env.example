# API keys and environment variables
# Define your variables here

# VERCEL_BACKEND_URL: Critical for scraping dynamic data (P/L, ROE, etc.)
# If not set to a valid Vercel URL, advanced metrics will be unavailable.
VERCEL_BACKEND_URL=https://servidor-valorae.vercel.app

# Supabase Auth / Sync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Valorae Proxy - fonte oficial de dados do app VALORAE
# Substitua pelo domínio HTTPS do seu deploy do Valorae Proxy no Vercel.
VALORAE_API_BASE_URL=https://servidor-valorae.vercel.app
VALORAE_PROXY_BASE_URL=https://servidor-valorae.vercel.app
VALORAE_PUBLIC_BASE_URL=https://servidor-valorae.vercel.app
VALORAE_PROXY_CLIENT_ID=valorae-investidor-android

# Mantenha false para garantir que o app consuma dados pelo Valorae Proxy.
# Não habilite fallback direto no app; todas as informações externas devem vir pelo Proxy.
VALORAE_DIRECT_FALLBACK_ENABLED=false

# Supabase opcional para snapshots/sincronização
# Use publishable/anon key no APK. Nunca use service_role no app Android.
SUPABASE_SYNC_ENABLED=true
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=

# Ponte segura via VALORAE Proxy, útil quando você quiser deixar secrets só no backend.
VALORAE_SUPABASE_PROXY_SYNC_ENABLED=true
VALORAE_SUPABASE_SYNC_TOKEN=troque-por-um-token-longo-opcional

# Backup automático opcional. Mantenha false até validar seu schema/RLS.
VALORAE_SUPABASE_AUTO_BACKUP_ENABLED=false
VALORAE_SUPABASE_AUTO_ENCRYPTION_SECRET=
