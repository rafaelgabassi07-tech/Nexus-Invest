# API keys and environment variables
# Define your variables here

# VERCEL_BACKEND_URL: Critical for scraping dynamic data (P/L, ROE, etc.)
# If not set to a valid Vercel URL, advanced metrics will be unavailable.
VERCEL_BACKEND_URL=https://servidor-valorae.vercel.app

# Supabase Auth / Sync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Valorae Proxy - fonte oficial de dados do app VALORAE
# Substitua pelo domínio HTTPS do seu deploy do Valorae Proxy no Vercel.
VALORAE_PROXY_BASE_URL=https://servidor-valorae.vercel.app
VALORAE_PROXY_CLIENT_ID=valorae-investidor-android

# Mantenha false para garantir que o app consuma dados pelo Valorae Proxy.
# Use true apenas como contingência manual caso o Proxy esteja indisponível.
VALORAE_DIRECT_FALLBACK_ENABLED=false
